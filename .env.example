# Copy to .env and replace asset paths for your Jetson. Never commit .env.
CROWD_PORT=8090
CROWD_PUBLIC_HOST=127.0.0.1
CROWD_DATA=./data
CROWD_ASSETS=/home/seeed/mtp_demo
CROWD_VIDEO=/home/seeed/mtp_demo/people-walking.mp4
CROWD_MODEL=/home/seeed/mtp_demo/models/Qwen3.5-4B-Q4_K_M.gguf
CROWD_LLAMA=/home/seeed/llama.cpp/build/bin/llama-server
# Native TensorRT/CUDA is inherited from JetPack; use system Python 3.10.
CROWD_ENGINE=/absolute/path/yolo11n_fp16.engine
CROWD_ONNX=/absolute/path/yolo11n.onnx
# Local development / optional remote deployment:
# CROWD_API_URL=http://JETSON_IP:8090
# CROWD_SSH=seeed@JETSON_IP
# CROWD_REMOTE_DIR=/home/seeed/mtp_demo/edge-crowd-agent
